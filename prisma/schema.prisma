// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  // Generate my Client and Project types
  output   = "../src/generated/prisma"
  runtime  = "deno"
}

datasource db {
  provider = "postgresql"
}

model ProgressLog {
  id Int @id @default(autoincrement())
  userID String
  createdAt DateTime @default(now())
  type Int
  product Int
  summary String
  // The Discord ID of the message logged in the updates channel, used so we can delete it if the user deletes the log
  logMessageID String? @unique
}

model Wrap {
  id Int @id @default(autoincrement())
  userID String
  createdAt DateTime @default(now())
  content String
  // The Discord ID of the wrap message sent
  wrapMessageID String @unique
}

model Reminder {
  id Int @id @default(autoincrement())
  userID String
  channelID String
  createdAt DateTime @default(now())
  content String
  time DateTime
  link String
  // The Discord ID of the message that was sent to the user, to remind them of the reminder
  reminderMessageID String? @unique
}

model StaffDailyReminder {
  userID            String    @id
  githubUsername    String?   @unique
  optedIn           Boolean   @default(false)
  time              String    @default("17:00")
  timezone          String    @default("America/Chicago")
  lastSentDate      String?
  lastGithubCheckAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model GithubContribution {
  deliveryID     String   @id
  githubUsername String
  repository     String
  eventType      String
  occurredAt     DateTime

  @@index([occurredAt])
}
