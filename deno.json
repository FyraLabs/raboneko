{
  "nodeModulesDir": "auto",
  "tasks": {
    "sync": "slash-up sync",
    "sync:dev": "slash-up sync -e development",
    "generate": "prisma generate",
    "start": "deno run -P --unsafe-proto src/index.ts",
    "dev": "deno watch -P --unsafe-proto --watch --no-clear-screen src/index.ts",
  },
  "imports": {
    "@ai-sdk/azure": "npm:@ai-sdk/azure@^4.0.21",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.8.0",
    "@prisma/client": "npm:@prisma/client@^7.8.0",
    "@sentry/cli": "npm:@sentry/cli@^3.6.0",
    "@sentry/deno": "npm:@sentry/deno@^10.64.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.7",
    "ai": "npm:ai@^7.0.37",
    "bullmq": "npm:bullmq@^5.80.1",
    "cat-loggr": "npm:cat-loggr@^1.2.2",
    "dayjs": "npm:dayjs@^1.11.21",
    "discord-api-types": "npm:discord-api-types@^0.38.49",
    "discord.js": "npm:discord.js@^14.26.4",
    "fastify": "npm:fastify@^5.10.0",
    "parse-duration": "npm:parse-duration@^2.1.6",
    "prisma": "npm:prisma@^7.8.0",
    "slash-create": "npm:slash-create@^6.8.1",
    "slash-up": "npm:slash-up@^1.4.2",
    "zod": "npm:zod@^4.1.8"
  },
  "permissions": {
    "default": {
      "env": true,
      "net": true,
      "read": true,
      "ffi": true,
      "sys": true
    }
  }
}
