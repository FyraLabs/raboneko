{
  "nodeModulesDir": "auto",
  "tasks": {
    "sync": "slash-up sync",
    "sync:dev": "slash-up sync -e development",
    "generate": "prisma generate",
    "start": "deno run -P --unsafe-proto src/index.ts",
    "dev": "deno watch -P --unsafe-proto --watch --no-clear-screen src/index.ts"
  },
  "imports": {
    "@ai-sdk/azure": "npm:@ai-sdk/azure@^4.0.24",
    "@ai-sdk/mistral": "npm:@ai-sdk/mistral@^4.0.22",
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@^3.1103.0",
    "@aws-sdk/lib-storage": "npm:@aws-sdk/lib-storage@^3.1103.0",
    "@discordjs/voice": "npm:@discordjs/voice@^1.0.0-dev.1785370677-4b3f1c166",
    "@mediabunny/server": "npm:@mediabunny/server@^1.52.3",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.9.1",
    "@prisma/client": "npm:@prisma/client@^7.9.1",
    "@sentry/cli": "npm:@sentry/cli@^3.6.2",
    "@sentry/deno": "npm:@sentry/deno@^10.69.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/async": "jsr:@std/async@^1.5.0",
    "@std/cbor": "jsr:@std/cbor@^0.1.9",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.7",
    "ai": "npm:ai@^7.0.37",
    "bullmq": "npm:bullmq@^5.81.2",
    "cat-loggr": "npm:cat-loggr@^1.2.2",
    "dayjs": "npm:dayjs@^1.11.21",
    "discord-api-types": "npm:discord-api-types@^0.38.52",
    "discord.js": "npm:discord.js@^14.27.0",
    "fastify": "npm:fastify@^5.10.0",
    "mediabunny": "npm:mediabunny@^1.52.3",
    "node-web-audio-api": "npm:node-web-audio-api@^2.1.0",
    "parse-duration": "npm:parse-duration@^2.1.6",
    "prisma": "npm:prisma@^7.9.1",
    "slash-create": "npm:slash-create@^7.0.0",
    "slash-up": "npm:slash-up@^1.4.2",
    "zod": "npm:zod@^4.1.8"
  },
  "permissions": {
    "default": {
      "env": true,
      "net": true,
      "read": true,
      "write": true,
      "ffi": true,
      "sys": true,
      "run": true
    }
  },
  "allowScripts": [
    "npm:@prisma/engines@",
    "npm:prisma"
  ]
}
